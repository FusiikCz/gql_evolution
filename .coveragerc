[run]
source = src
omit = 
    */tests/*
    */__pycache__/*
    */venv/*
    */env/*
    */site-packages/*
    */migrations/*
    */alembic/*
    src/Utils/explain_query.py
    src/Utils/utils_sdl_2.py
    src/Utils/GraphQLQueryBuilder.py
    src/Utils/gql_client.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod

precision = 2
show_missing = True
skip_covered = False

[html]
directory = htmlcov
